root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

# Preserve captured configuration and recovery snapshots on save.
[*.{cfg,conf,bkp}]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset

# Lockfiles are written by their owning tool.
[devenv.lock]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.gz]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
